<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 备份/迁移规则：显式排除会话凭证目录。
  凭证（token / csrf / API Key / RSA 私钥 / cf_clearance）不得随云备份或换机迁移离开本设备。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path=".cookies/" />
        <exclude domain="file" path="app_flutter/.cookies/" />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path=".cookies/" />
        <exclude domain="file" path="app_flutter/.cookies/" />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
